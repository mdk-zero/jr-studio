# Supabase (Project Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Never expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Resend (transactional email)
RESEND_API_KEY=re_xxx
EMAIL_FROM="J&R Studio <bookings@yourdomain.com>"
# Where studio-facing notifications (new booking, contact message) are sent
STUDIO_NOTIFY_EMAIL=studio@yourdomain.com
# Sending-only Resend key, limited to your domain. Supabase Auth uses it as its
# SMTP password (read by `supabase config push`); it is never stored in git.
RESEND_SMTP_KEY=re_xxx
# Anything but "live" sends every email to Resend's test inbox instead of the
# real recipient, so a dev database can never email a real customer.
EMAIL_MODE=test
# Optional: salt for hashing visitor IPs in the contact form's rate limit.
# Defaults to the Supabase secret key.
RATE_LIMIT_SALT=

# Public base URL, used in email links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
