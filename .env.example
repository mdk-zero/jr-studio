# Supabase (Project Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Never expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Resend (transactional email)
RESEND_API_KEY=re_xxx
EMAIL_FROM="J&R Studio <bookings@yourdomain.com>"
# Where studio-facing notifications (new booking, contact message) are sent
STUDIO_NOTIFY_EMAIL=studio@yourdomain.com

# Public base URL, used in email links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
